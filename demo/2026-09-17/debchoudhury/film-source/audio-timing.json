[
  {
    "line": 1,
    "start": 0.7,
    "end": 2.6875,
    "text": "The next shift is waiting.",
    "naturalDuration": 2,
    "tempo": 1
  },
  {
    "line": 2,
    "start": 4.3,
    "end": 7.7615,
    "text": "Maya has two minutes to get a maintenance update ready.",
    "naturalDuration": 3.475,
    "tempo": 1
  },
  {
    "line": 3,
    "start": 10.2,
    "end": 12.713541666666666,
    "text": "An agent can do it in seconds.",
    "naturalDuration": 2.525,
    "tempo": 1
  },
  {
    "line": 4,
    "start": 14.2,
    "end": 17.396666666666665,
    "text": "She asks for an update. Not a publication.",
    "naturalDuration": 3.2,
    "tempo": 1
  },
  {
    "line": 5,
    "start": 19.1,
    "end": 23.319833333333335,
    "text": "But a helpful next step can cross a line she never meant to cross.",
    "naturalDuration": 4.225,
    "tempo": 1
  },
  {
    "line": 6,
    "start": 28.1,
    "end": 31.26441666666667,
    "text": "The note moves toward a shared repository.",
    "naturalDuration": 3.175,
    "tempo": 1
  },
  {
    "line": 7,
    "start": 33,
    "end": 35.741166666666665,
    "text": "An internal-only detail goes with it.",
    "naturalDuration": 2.75,
    "tempo": 1
  },
  {
    "line": 8,
    "start": 37.6,
    "end": 41.038916666666665,
    "text": "The draft took seconds. The damage lasts longer.",
    "naturalDuration": 3.45,
    "tempo": 1
  },
  {
    "line": 9,
    "start": 43.4,
    "end": 46.266666666666666,
    "text": "Rewind. A prompt is not a policy.",
    "naturalDuration": 2.875,
    "tempo": 1
  },
  {
    "line": 10,
    "start": 48,
    "end": 51.51916666666666,
    "text": "The organization owns the rules. Not the model.",
    "naturalDuration": 3.525,
    "tempo": 1
  },
  {
    "line": 11,
    "start": 53.4,
    "end": 56.565999999999995,
    "text": "Same request. This time, through Airlock.",
    "naturalDuration": 3.175,
    "tempo": 1
  },
  {
    "line": 12,
    "start": 57.8,
    "end": 62.535666666666664,
    "text": "The local work goes through. A real draft lands in the local outbox.",
    "naturalDuration": 4.75,
    "tempo": 1
  },
  {
    "line": 13,
    "start": 63.4,
    "end": 65.33966666666666,
    "text": "Nothing goes online.",
    "naturalDuration": 1.95,
    "tempo": 1
  },
  {
    "line": 14,
    "start": 66.2,
    "end": 69.967,
    "text": "Then comes a proposed push. The first gate says no.",
    "naturalDuration": 3.775,
    "tempo": 1
  },
  {
    "line": 15,
    "start": 71.3,
    "end": 76.39425,
    "text": "No online writes. Its code matches the push against a separate rule file.",
    "naturalDuration": 5.2,
    "tempo": 1.0196078431372544
  },
  {
    "line": 16,
    "start": 77,
    "end": 79.79425,
    "text": "The hook denies it before execution.",
    "naturalDuration": 2.85,
    "tempo": 1.0178571428571408
  },
  {
    "line": 17,
    "start": 80.3,
    "end": 82.98983333333334,
    "text": "A second gate checks the draft itself.",
    "naturalDuration": 2.7,
    "tempo": 1
  },
  {
    "line": 18,
    "start": 84.7,
    "end": 89.08829166666666,
    "text": "Sensitive information. An internal-only label means ask first.",
    "naturalDuration": 4.475,
    "tempo": 1.0170454545454544
  },
  {
    "line": 19,
    "start": 89.6,
    "end": 93.46108333333333,
    "text": "Here, approval isn't implemented. So it stays blocked.",
    "naturalDuration": 3.875,
    "tempo": 1
  },
  {
    "line": 20,
    "start": 94.5,
    "end": 98.21691666666666,
    "text": "The runtime records the rule, the verdict, and the time.",
    "naturalDuration": 3.725,
    "tempo": 1
  },
  {
    "line": 21,
    "start": 100.1,
    "end": 103.41862499999999,
    "text": "Not a promise. A record someone can inspect.",
    "naturalDuration": 3.325,
    "tempo": 1
  },
  {
    "line": 22,
    "start": 104.2,
    "end": 106.99454166666666,
    "text": "Local evidence. Not tamper-proof.",
    "naturalDuration": 2.8,
    "tempo": 1.000000000000003
  },
  {
    "line": 23,
    "start": 107.5,
    "end": 111.614125,
    "text": "A local prototype. Not a sandbox for every process.",
    "naturalDuration": 4.125,
    "tempo": 1
  },
  {
    "line": 24,
    "start": 112.5,
    "end": 115.86975,
    "text": "The organization sets what agents may do.",
    "naturalDuration": 3.375,
    "tempo": 1
  },
  {
    "line": 25,
    "start": 116.3,
    "end": 119.491625,
    "text": "Airlock makes that binding on the paths it checks.",
    "naturalDuration": 3.2,
    "tempo": 1.0000000000000009
  }
]