{
  "version": 1,
  "hooks": {
    "userPromptSubmitted": [
      {
        "type": "command",
        "powershell": "node \"$env:COPILOT_PLUGIN_ROOT\\hooks\\user-prompt-submitted.mjs\"",
        "bash": "node \"$COPILOT_PLUGIN_ROOT/hooks/user-prompt-submitted.mjs\"",
        "timeoutSec": 10
      },
      {
        "type": "command",
        "powershell": "node \"$env:COPILOT_PLUGIN_ROOT\\hooks\\rfc-relevance.mjs\"",
        "bash": "node \"$COPILOT_PLUGIN_ROOT/hooks/rfc-relevance.mjs\"",
        "timeoutSec": 5
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "matcher": ".*",
        "powershell": "node \"$env:COPILOT_PLUGIN_ROOT\\hooks\\pre-tool-use.mjs\"",
        "bash": "node \"$COPILOT_PLUGIN_ROOT/hooks/pre-tool-use.mjs\"",
        "timeoutSec": 10
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "powershell": "node \"$env:COPILOT_PLUGIN_ROOT\\hooks\\session-end.mjs\"",
        "bash": "node \"$COPILOT_PLUGIN_ROOT/hooks/session-end.mjs\"",
        "timeoutSec": 5
      }
    ]
  }
}
